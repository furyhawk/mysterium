# ── Version control ─────────────────────────────────────────────────
.git/
.gitignore

# ── Python / Virtual environment ────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
htmlcov/

# ── Environment ─────────────────────────────────────────────────────
.env
.env.local

# ── Frontend (rebuilt inside the image; never ship deps/build caches) ──
frontend/node_modules/
frontend/.vite/

# ── IDE / Editors ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Containers (don't re-copy build outputs) ───────────────────────
Dockerfile
docker-compose.yml
.dockerignore
Makefile
README.md
