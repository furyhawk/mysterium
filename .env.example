# ── Mysterium Configuration ─────────────────────────────────────────
# Copy this file to .env and fill in the values.

# verity-rag server URL (default: http://localhost:8100)
RAG_SERVER_URL=http://localhost:8100

# Anthropic API key for research agent
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: custom base URL for an Anthropic-compatible gateway/proxy
# ANTHROPIC_BASE_URL=https://your-gateway.example.com
# Optional: maximum output tokens for research report generation
# ANTHROPIC_MAX_TOKENS=32768

# Augment RAG research with web search (default: true)
# Set to false for fully offline research against documents only.
# RESEARCH_USE_WEB=true

# Enable web page fetch. Unset = auto: on with the official Anthropic API,
# off for ANTHROPIC_BASE_URL gateways only when the local fetch tool is off
# (most Anthropic-compatible gateways reject Anthropic's server-side tool).
# Set true/false explicitly to override.
# RESEARCH_WEB_FETCH=

# Fetch pages with a LOCAL markdownify-based tool (default: true) instead of
# Anthropic's server-side web-fetch tool. Local fetching works with every
# Anthropic-compatible gateway (e.g. DeepSeek).
# RESEARCH_WEB_FETCH_LOCAL=true

# Mysterium server configuration
HOST=0.0.0.0
PORT=8200
LOG_LEVEL=info
